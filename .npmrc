# node_modules here was created with virtual-store-dir-max-length=60 rather than
# pnpm's default of 120. That is deliberate: this repo is cloned to a deep path on
# Windows ("D:\AI Projects\Claude Code\Lovely Tools"), and the default-length
# directory names inside node_modules/.pnpm push the heavier transitive trees
# (@huggingface/transformers, ffmpeg, tesseract) past the 260-character MAX_PATH
# limit, which fails the install with unreadable ENOENT errors.
#
# It lives here rather than on the install command line because pnpm records the
# value in node_modules/.modules.yaml and refuses to reuse a modules directory
# built with a different one:
#
#   ERR_PNPM_VIRTUAL_STORE_DIR_MAX_LENGTH_DIFF
#
# Passing it by hand once meant every later `pnpm add` hit that error and
# demanded a full reinstall. Committing it makes every pnpm invocation agree.
# Harmless on Linux/CI — it only shortens directory names, deterministically.
virtual-store-dir-max-length=60
